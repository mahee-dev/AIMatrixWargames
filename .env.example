# AMAW environment configuration — copy to .env and fill in.
# .env is git-ignored. Never commit real keys.

# Model gateway (required for MVP-1 onward; layers 1-3 of the test suite run without it)
OPENROUTER_API_KEY=

# Fixed Gate-2 autonomous smoke-test condition. OpenRouter model identifiers; use the same
# Umpire setting across runs that are intended to be comparable.
AMAW_PLAYER_MODEL=deepseek/deepseek-v4-flash-0731
AMAW_UMPIRE_MODEL=deepseek/deepseek-v4-flash-0731
# Player execution condition: single_shot (default) or tool_loop.
AMAW_PLAYER_ACTIVATION_MODE=single_shot
# Tools offered to the player: broad (default; the whole set, so illegal attempts are measured)
# or available_only (only the legal tools; tool_loop only).
AMAW_PLAYER_TOOL_SURFACE=broad
# I-057 agent-configuration treatments. Released defaults are sequential/full.
AMAW_PLAYER_RESEARCH_MODE=sequential-v1
AMAW_PLAYER_RESEARCH_HISTORY_MODE=full-v1
# Resource matching/ranking. Released default search-v2 (D-087/D-088); search-v1 is the original
# whole-query substring ranking, kept for reproducing runs recorded under it.
AMAW_PLAYER_SEARCH_CONTRACT=search-v2
# I-032 per-phase inference profile (inference-profile-v1 YAML/JSON path). Unset ⇒ uniform.
# AMAW_INFERENCE_PROFILE=

# Admin/facilitator token for administrative endpoints (api.md §2.4). Separate from Seat
# tokens — a Seat token must never authorize an admin endpoint. Unset ⇒ admin surface closed.
AMAW_ADMIN_TOKEN=

# Persistence
AMAW_DATABASE_PATH=./data/amaw.db

# Logging: DEBUG | INFO | WARNING | ERROR
AMAW_LOG_LEVEL=INFO
# Optional timestamped, secret-redacted operational log file. Leave unset for stream-only logs.
# AMAW_LOG_FILE=./dev/runs/overnight/run.log

# Outbound request timeout in seconds (model gateway; used from MVP-1 onward)
AMAW_REQUEST_TIMEOUT_SECONDS=60

# Bounded autonomous activation concurrency (1 = serial coordinator path)
AMAW_DIPLOMACY_CONCURRENCY=4
AMAW_CONS_CONCURRENCY=4
# Game-loop conditions resolve as: CLI flag, then an AMAW_* value that is set (here or in the
# environment), then the scenario's game.* default, then the released default (D-099). A value
# set here counts as explicit and overrides the scenario, so leave these commented out unless you
# mean to force a condition for every scenario.
# Diplomacy: released default open_diplomacy. For the explicit experiment, select bounded_rounds
# and set a positive round count. Leave the count unset for open_diplomacy.
# AMAW_DIPLOMACY_MODE=bounded_rounds
# AMAW_DIPLOMACY_ROUNDS_PER_TURN=3
# Con opposition: released default open_cons. For the explicit experiment, select sampled_sealed
# and set a positive challenger count (at most the number of opponents).
# AMAW_CON_MODE=sampled_sealed
# AMAW_CON_CHALLENGERS_PER_ARGUMENT=2

# Released Con-reply condition: Cons reach only the Umpire and the owner does not reply. To run
# the explicit visible-rebuttal experiment, select visible_reply and set the reply bound (1–3).
# The Umpire prompt is its own condition: unset means umpire-v1.6 when the scenario declares
# rules, else umpire-v1.3 for sealed_cons and the reply-aware umpire-v1.4 for visible_reply; pin
# umpire-v1.4 on both for a comparison.
AMAW_CON_REPLY_MODE=sealed_cons
# AMAW_REPLY_MAX_POINTS=3
# AMAW_UMPIRE_PROMPT_VERSION=umpire-v1.4

# End-of-turn consequence pass: none or bounded_effects_v1. Unset defers to the scenario's
# game.consequence_mode (released default none); setting it overrides the scenario.
# The bounded_effects_v1 resolver model defaults to the Umpire model.
# AMAW_CONSEQUENCE_MODE=bounded_effects_v1
# AMAW_CONSEQUENCE_MODEL=deepseek/deepseek-v4-flash-0731

# Normal outgoing-Message budget for each Actor activation. The separate emergency phase
# ceiling remains 10. Zero disables Message sends while other legal actions remain available.
AMAW_MAX_MESSAGES_PER_ACTIVATION=3

# Per-activation/recovery guardrails. Raise these for a deliberately generous unattended run,
# but keep them finite so a broken provider or player cannot run indefinitely.
AMAW_MAX_LLM_ITERATIONS=12
AMAW_MAX_TOOL_CALLS=20
AMAW_MAX_RESEARCH_TOOL_CALLS=4
# Searches and reads per activation, however many research calls carry them.
AMAW_MAX_RESEARCH_OPERATIONS=4
AMAW_MAX_MESSAGES_PER_PHASE=10
AMAW_MAX_ACTIVATIONS_PER_OPPORTUNITY=6

# Observer relay (TRD §41.1): where `amaw publish` and `amaw run --publish` push games.
# Published games include every Actor's private material. https only, except to this machine.
# AMAW_RELAY_URL=https://relay.example.com
# AMAW_RELAY_TOKEN=
